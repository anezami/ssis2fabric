              <properties>
                <property
                  dataType="System.Int32"
                  description="Access mode"
                  name="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="SQL command"
                  name="SqlCommand"><![CDATA[SELECT C.CustomerID, C.FullName, C.Email, CL.CountryName, SYSUTCDATETIME() AS ValidFrom
