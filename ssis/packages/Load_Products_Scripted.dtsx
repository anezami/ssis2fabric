                    <inputColumn refId="Package\DFT_LoadProducts\SCR_Enrich.Inputs[Input 0].Columns[IsActive]" cachedDataType="i4" cachedName="IsActive" lineageId="Package\DFT_LoadProducts\FF_SRC_Products.Outputs[Flat File Source Output].Columns[IsActive]" usageType="readOnly" />
