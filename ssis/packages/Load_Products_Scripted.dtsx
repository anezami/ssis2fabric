              description="Uppercase Sku; derive MarginCategory from Price"
              name="SCR_Enrich"
              usesDispositions="true"
              version="1">
              <properties>
                <property dataType="System.String" name="UserComponentTypeName">Microsoft.SqlServer.Dts.Pipeline.ScriptComponentHost, Microsoft.SqlServer.TxScript, Version=14.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91</property>
                <property dataType="System.String" name="ScriptLanguage">CSharp</property>
                <property dataType="System.String" name="ReadOnlyVariables"></property>
                <property dataType="System.String" name="ReadWriteVariables"></property>
                <property dataType="System.String" name="SourceCode" isArray="true" state="escaped">
                  <arrayElements>
                    <arrayElement>\main.cs</arrayElement>
                    <arrayElement>using System;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    // Uppercases Sku in place and emits a MarginCategory bucket based on Price.
    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        if (!Row.Sku_IsNull)
        {
            Row.Sku = Row.Sku.ToUpperInvariant();
        }

        decimal price = Row.Price_IsNull ? 0m : Row.Price;
        if (price &lt; 50m)
        {
            Row.MarginCategory = "LOW";
        }
        else if (price &lt; 200m)
        {
            Row.MarginCategory = "MEDIUM";
        }
        else
        {
            Row.MarginCategory = "HIGH";
        }
    }
}</arrayElement>
                  </arrayElements>
                </property>
              </properties>
              <inputs>
                <input refId="Package\DFT_LoadProducts\SCR_Enrich.Inputs[Input 0]" name="Input 0">
                  <inputColumns>
                    <inputColumn refId="Package\DFT_LoadProducts\SCR_Enrich.Inputs[Input 0].Columns[ProductID]" cachedDataType="i4" cachedName="ProductID" lineageId="Package\DFT_LoadProducts\FF_SRC_Products.Outputs[Flat File Source Output].Columns[ProductID]" usageType="readOnly" />
