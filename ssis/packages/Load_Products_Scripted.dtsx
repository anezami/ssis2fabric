                    <externalMetadataColumn refId="Package\DFT_LoadProducts\OLE_DST_DimProduct.Inputs[OLE DB Destination Input].ExternalColumns[Name]" dataType="wstr" length="200" name="Name" />
                    <externalMetadataColumn refId="Package\DFT_LoadProducts\OLE_DST_DimProduct.Inputs[OLE DB Destination Input].ExternalColumns[Category]" dataType="wstr" length="50" name="Category" />
                    <externalMetadataColumn refId="Package\DFT_LoadProducts\OLE_DST_DimProduct.Inputs[OLE DB Destination Input].ExternalColumns[Price]" dataType="numeric" precision="10" scale="2" name="Price" />
